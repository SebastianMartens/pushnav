  "cards": [
    {
      "dot": "cyan",
      "title": "Server selection (Windows only)",
      "items": [
        "camera.windows_server: \"dotnet\" (default) or \"c\"; env PUSHNAV_CAMERA_SERVER overrides it",
        "Selected exe missing: warning, then the other exe starts; neither: FileNotFoundError",
        "Ignored on macOS and Linux"
      ]
    },
    {
      "dot": "amber",
      "title": "Exit code 3 fallback",
      "items": [
        "Only the C# server exits 3 for no supported camera",
        "With \"dotnet\", the C server then starts in the same attempt, using no backoff step",
        "The server that connected is remembered for recovery"
      ]
    },
    {
      "dot": "violet",
      "title": "Fork vs upstream",
      "items": [
        "The C server stays unmodified next to the C# server",
        "The UVC backend is not registered in the C# server today",
        "SubprocessManager is upstream code with small \"# fork:\" hooks into server_select"
      ]
    }
  ]
