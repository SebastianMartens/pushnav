  "cards": [
    {
      "dot": "cyan",
      "title": "One process, three servers",
      "items": [
        "Stellarium, LX200 and web servers run in the engine process",
        "LX200 :4030 also serves INDI and ASCOM clients",
        "Stellarium server queries Stellarium's Remote Control API (localhost:8090) on client connect and after each GOTO, best effort",
        "Bind: LX200 and web 0.0.0.0; Stellarium 127.0.0.1 (0.0.0.0 on a Pi). Web port 8765 by default (webserver.port)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Latest frame only",
      "items": [
        "The camera client overwrites one LatestFrame; there is no frame queue",
        "The solver thread never blocks the UI",
        "The camera server is a separate process, so a camera crash cannot take the engine down"
      ]
    },
    {
      "dot": "amber",
      "title": "Headless mode",
      "items": [
        "With --no-window the desktop window is not created",
        "The phone browser then is the UI"
      ]
    }
  ]
